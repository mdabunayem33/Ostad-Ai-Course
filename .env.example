# ---------------------------------------------------------------------------
# Customer Support Triager — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Anthropic / Claude API (required) ---
ANTHROPIC_API_KEY=your-api-key-here

# Claude model ID used for triage.
# Sonnet is a strong cost/quality fit for high-volume support triage.
# Swap to a more capable model (e.g. an Opus tier) if quality demands it.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Tiered models for cost-aware routing (Step 3):
#   MODEL_FAST  -> lightweight tasks (prescreen, simple triage)
#   MODEL_SMART -> complex reasoning (hard/ambiguous triage)
MODEL_FAST=claude-haiku-4-5
MODEL_SMART=claude-sonnet-4-5

# Default output-token ceiling per response.
MAX_TOKENS=2048

# Web Search server tool (Step 8):
#   Use web_search_20250305 for Sonnet 4.5 / Haiku 4.5.
#   Newer models (Sonnet 4.6+, Opus 4.6+) can use web_search_20260209.
WEB_SEARCH_TOOL_TYPE=web_search_20250305
WEB_SEARCH_MAX_USES=3

# GitHub MCP server (Step 9). Create a PAT with repo/issues access.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_MCP_BETA=mcp-client-2025-11-20

# --- Application ---
APP_NAME=customer-support-triager

# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
